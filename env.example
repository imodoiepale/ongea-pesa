# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
NEXT_PUBLIC_AGENT_ID=your_agent_id_here

# Gemini AI Configuration
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (if using)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Site URL — production: https://ongeapesa.nsait.co.ke  (localhost for dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# n8n Webhook URL (for voice transaction processing)
N8N_WEBHOOK_URL=https://primary-production-579c.up.railway.app/webhook/send_money

# n8n instance hosting the NCBA STK Push / send_money workflows
N8N_WEBHOOK_BASE_URL=https://n8n-lc5r.srv1631847.hstgr.cloud

# App URL n8n calls back on to report NCBA STK deposit outcomes
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for the n8n -> app callbacks /api/ncba/stk-result and /api/ncba/stk-sweep.
# REQUIRED for NCBA STK deposits: these endpoints credit wallets, so they fail closed
# when this is unset. Generate with: openssl rand -hex 32
# The same value must be set as ONGEA_CALLBACK_SECRET in the n8n instance for the
# (disabled by default) "Stale Sweep Schedule" branch, alongside ONGEA_APP_URL.
N8N_CALLBACK_SECRET=

# Resend — email delivery for OTP and Supabase SMTP relay
# Get your API key at https://resend.com/api-keys
# nsait.co.ke must be a verified domain in your Resend account
RESEND_API_KEY=
RESEND_FROM="Ongea Pesa <ongeapesa@nsait.co.ke>"
