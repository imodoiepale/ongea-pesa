# Copy this file to .env.local and fill in your values.
# All vars without NEXT_PUBLIC_ prefix are server-only (never exposed to the browser).

# === n8n Webhook Base URL ===
N8N_WEBHOOK_BASE_URL=https://primary-production-579c.up.railway.app

# === Supabase (required) ===
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_URL=https://<project-ref>.supabase.co

# === ElevenLabs (required for voice) ===
NEXT_PUBLIC_AGENT_ID=<elevenlabs-agent-id>
ELEVENLABS_API_KEY=<elevenlabs-api-key>
NEXT_PUBLIC_ELEVENLABS_API_KEY=<elevenlabs-api-key>

# === OCR (scanner: OpenAI primary, Gemini fallback) ===
OPENAI_API_KEY=<openai-key>          # server-only — do NOT prefix with NEXT_PUBLIC_
GEMINI_API_KEY=<gemini-key>          # server-only (fallback)
NEXT_PUBLIC_GEMINI_API_KEY=<gemini-key>  # client-side auto-detect loop only

# === n8n webhook auth token (Next.js → n8n) ===
N8N_WEBHOOK_AUTH_TOKEN=<secret>

# === Cron / scheduled jobs ===
CRON_API_KEY=<secret>

# === Site URLs (OAuth redirects & callbacks) ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === IndexPay / Gate.io wallet infra ===
GATE_API_KEY=<key>
GATE_SECRET_KEY=<secret>
GATE_API_URL=<url>
NEXT_PUBLIC_INDEXPAY_URL=<url>
INDEXPAY_API_KEY=<key>

NODE_ENV=development

# === Security / WebAuthn ===
# Set to your production domain when deploying.
# RP_ID must match the domain the browser sees (no port, no protocol).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# === Admin (comma-separated emails) ===
ADMIN_EMAILS=admin@example.com

# === Biometric auth (Phase 5) ===

# Picovoice Eagle — server-side voice biometric speaker verification.
# Get a free key at https://picovoice.ai (sign up → Access Key).
# Without this key, voice biometrics degrade to a passphrase-based lower-assurance flow;
# all other biometric methods (face/fingerprint/PIN) are unaffected.
PICOVOICE_ACCESS_KEY=<picovoice-access-key>

# AES-256-GCM encryption key for voiceprint storage at rest.
# Generate: openssl rand -base64 32
# IMPORTANT: Rotating this key invalidates ALL stored voiceprints — all enrolled users
# must re-enroll after a key rotation. Store securely (e.g. in your secrets manager).
VOICE_ENC_KEY=<base64-encoded-32-byte-key>
